{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/ping.ts": { "maxDuration": 10 },
    "api/health.ts": { "maxDuration": 60 }
  }
}
